<Window x:Class="ManuscriptCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ManuscriptCalculator"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="计算稿纸"
        Width="960" Height="620" MinWidth="720" MinHeight="480"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        Icon="app.ico"
        WindowStartupLocation="CenterScreen"
        SourceInitialized="OnSourceInitialized"
        Activated="OnActivated" Deactivated="OnDeactivated"
        FocusManager.FocusedElement="{Binding ElementName=rowsHost}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0,0,0,1"
                            CaptionHeight="0"
                            ResizeBorderThickness="4" />
    </shell:WindowChrome.WindowChrome>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction>
                            <QuarticEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding HideCommand}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyActiveResultCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding ClearAllCommand}" />
    </Window.InputBindings>
    <Border Background="{DynamicResource CanvasBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="30" Height="26"
                        Background="#FFC107" CornerRadius="7"
                        Margin="18,0,12,0">
                    <TextBlock Text="=" FontSize="18" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="计算稿纸"
                           FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI" FontSize="19" FontWeight="SemiBold"
                           Foreground="{DynamicResource InkStrongBrush}"
                           VerticalAlignment="Center" />

                <Button Grid.Column="3" Content="清空"
                        Width="56" Height="32"
                        Style="{StaticResource PillButtonStyle}"
                        Click="OnClearClicked" Margin="0,0,14,0" />
                <Button Grid.Column="4" Content="✕"
                        Width="40" Height="32"
                        Style="{StaticResource PillButtonStyle}"
                        Click="OnHideClicked" Margin="0,0,18,0" />
            </Grid>

            <!-- 行列表 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Padding="18,0,18,0">
                <ItemsControl x:Name="rowsHost"
                              ItemsSource="{Binding Lines}"
                              AlternationCount="2"
                              Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:CalculatorLine
                                PreviewMouseLeftButtonDown="OnRowClicked" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="Transparent" Padding="18,8,18,0">
                <TextBlock Text="Enter 下一行    ↑↓ 切换    Ctrl+C 复制    Ctrl+R 清空    Esc 收起"
                           FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI" FontSize="13"
                           Foreground="{DynamicResource InkSoftBrush}" />
            </Border>
        </Grid>
    </Border>
</Window>
