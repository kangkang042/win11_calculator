<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Mica 云母透视：Canvas 85% 不透明度，纸面 94% -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#661A1A1A" />
    <SolidColorBrush x:Key="PaperLightBrush" Color="#F02D2D2D" />
    <SolidColorBrush x:Key="PaperAlternateBrush" Color="#F0282828" />
    <SolidColorBrush x:Key="ActivePaperBrush" Color="#E62A2D3E" />
    <SolidColorBrush x:Key="InkStrongBrush" Color="#E8E8E8" />
    <SolidColorBrush x:Key="InkMutedBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="InkSoftBrush" Color="#6A6A6A" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#6B8AFF" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF6B6B" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#333333" />
    <SolidColorBrush x:Key="ButtonFillBrush" Color="#E62D2D2D" />
    <SolidColorBrush x:Key="ButtonHoverFillBrush" Color="#E03A3A3A" />
    <SolidColorBrush x:Key="ButtonPressedFillBrush" Color="#D6444444" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#444444" />
    <SolidColorBrush x:Key="HoverRowBrush" Color="#E62F2F2F" />
</ResourceDictionary>
